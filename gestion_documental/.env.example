# Configuración de la base de datos PostgreSQL
DB_NAME=docuflow_db
DB_USER=sigea_app
DB_PASSWORD=cambiala-con-gestor-de-secretos-y-rota-la-actual
# M11: administrador solo para migrate y test (settings lo usa automáticamente)
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Django — H-09: nunca uses * en prod; DEBUG=False en prod
SECRET_KEY=cambiala-genera-con-python-secrets-token_urlsafe-50
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Solo dev local: DEBUG=True + DJANGO_INSECURE_DEV_KEY=1 si no hay SECRET_KEY
# DJANGO_INSECURE_DEV_KEY=0
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend  # prod: SMTP TLS real
# SEED_PASSWORD=solo-dev-genera-aleatorio-si-se-omite
# SEED_ALLOW_PROD=0

# Auditoría (C3): proxies inversos de confianza delante de Django.
# 0 = ignorar X-Forwarded-For (por defecto). Detrás de un Nginx: 1.
TRUSTED_PROXY_COUNT=0
